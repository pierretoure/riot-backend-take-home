# Secret used to compute/verify HMAC-SHA256 signatures. Required, >= 32 characters.
# Never commit a real secret; this is a placeholder value only.
HMAC_SECRET=change-me-to-a-random-secret-of-32-chars-min

# Optional, defaults to 3000.
PORT=3000

# Optional, defaults to development. Accepted: development | test | production.
NODE_ENV=development

# Optional, defaults to log. Accepted: fatal | error | warn | log | debug | verbose.
LOG_LEVEL=log

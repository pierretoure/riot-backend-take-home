# Secret used to compute/verify HMAC-SHA256 signatures. Required, >= 32 characters.
# Never commit a real secret; this is a placeholder value only.
HMAC_SECRET=change-me-to-a-random-secret-of-32-chars-min

# HTTP port the application listens on. Optional, defaults to 3000.
PORT=3000

# Runtime environment: development | test | production. Optional, defaults to development.
NODE_ENV=development

# Log verbosity level. Optional, defaults to log.
LOG_LEVEL=log
